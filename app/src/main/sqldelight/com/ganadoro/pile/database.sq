import com.ganadoro.pile.models.DocumentDetail;
import com.ganadoro.pile.models.ImageCropData;
import java.time.LocalDate;
import kotlin.String;
import kotlin.collections.List;


-- PileModel

CREATE TABLE IF NOT EXISTS PileModel(
    id              TEXT        PRIMARY KEY,
    name            TEXT        NOT NULL,
    iconId          TEXT        NOT NULL,
    colorNumber     INTEGER
);

insertPileModel:
INSERT INTO PileModel(id, name, iconId, colorNumber)
VALUES(?,?,?,?);

selectAllPileModels:
SELECT PileModel.*
FROM PileModel
ORDER BY PileModel.name ASC;

selectPileModelById:
SELECT PileModel.*
FROM PileModel
WHERE PileModel.id = ?;

selectPileModelsById:
SELECT PileModel.*
FROM PileModel
WHERE id IN ?
ORDER BY PileModel.name ASC;

updatePileModelName:
UPDATE PileModel
SET name = ?
WHERE id = ?;

updatePileModelIcon:
UPDATE PileModel
SET iconId = ?
WHERE id = ?;

updatePileModelColor:
UPDATE PileModel
SET colorNumber = ?
WHERE id = ?;

removePileModel:
DELETE FROM PileModel
WHERE PileModel.id = ?;


-- DocumentOrganization

CREATE TABLE IF NOT EXISTS DocumentOrganization(
    id              TEXT        PRIMARY KEY,
    name            TEXT        NOT NULL
);

insertDocumentOrganization:
INSERT INTO DocumentOrganization(id, name)
VALUES(?, ?);

selectAllDocumentOrganizations:
SELECT *
FROM DocumentOrganization;

selectDocumentOrganizationById:
SELECT *
FROM DocumentOrganization
WHERE id = ?;

removeDocumentOrganization:
DELETE FROM DocumentOrganization
WHERE id = ?;


-- DocumentModel

CREATE TABLE IF NOT EXISTS DocumentModel(
    id                          TEXT                            PRIMARY KEY,
    title                       TEXT                            NOT NULL,
    imageIds                    TEXT AS List<String>            NOT NULL,
    creationDate                TEXT AS LocalDate               NOT NULL,
    modificationDate            TEXT AS LocalDate               NOT NULL,
    documentPileIds             TEXT AS List<String>            NOT NULL,
    documentDetails             TEXT AS List<DocumentDetail>    NOT NULL,
    documentNote                TEXT                            NOT NULL,
    documentOrganizationIds     TEXT AS List<String>            NOT NULL
);

insertDocumentModel:
INSERT INTO DocumentModel(id, title, imageIds, creationDate, modificationDate, documentPileIds, documentDetails, documentNote, documentOrganizationIds)
VALUES(?, ?, ?, ?,?, ?, ?, ?, ?);

selectAllDocumentModels:
SELECT *
FROM DocumentModel;

selectDocumentModelById:
SELECT *
FROM DocumentModel
WHERE id = ?;

selectDocumentModelsByPileId:
SELECT *
FROM DocumentModel
WHERE documentPileIds LIKE ('%"' || ? || '"%');

removeDocumentModel:
DELETE FROM DocumentModel
WHERE id = ?;

updateDocumentTitle:
UPDATE DocumentModel
SET title = ?
WHERE id = ?;

updateDocumentImageIds:
UPDATE DocumentModel
SET imageIds = ?
WHERE id = ?;

updateDocumentModificationDate:
UPDATE DocumentModel
SET modificationDate = ?
WHERE id = ?;

updateDocumentPileIds:
UPDATE DocumentModel
SET documentPileIds = ?
WHERE id = ?;

updateDocumentDetails:
UPDATE DocumentModel
SET documentDetails = ?
WHERE id = ?;

updateDocumentNote:
UPDATE DocumentModel
SET documentNote = ?
WHERE id = ?;

updateDocumentOrganizationIds:
UPDATE DocumentModel
SET documentOrganizationIds = ?
WHERE id = ?;

-- DocumentImage

CREATE TABLE IF NOT EXISTS DocumentImage(
    id          TEXT                        PRIMARY KEY,
    crop        TEXT    AS ImageCropData,
    filter      INTEGER                     NOT NULL,
    rotation    INTEGER                     NOT NULL
);

insertDocumentImage:
INSERT INTO DocumentImage(id, crop, filter, rotation)
VALUES(?, ?, ?, ?);


selectAllDocumentImages:
SELECT *
FROM DocumentImage;

selectDocumentImageById:
SELECT *
FROM DocumentImage
WHERE id = ?;

removeDocumentImage:
DELETE FROM DocumentImage
WHERE id = ?;

updateCrop:
UPDATE DocumentImage
SET crop = ?
WHERE id = ?;

updateFilter:
UPDATE DocumentImage
SET filter = ?
WHERE id = ?;

updateRotation:
UPDATE DocumentImage
SET rotation = ?
WHERE id = ?;
