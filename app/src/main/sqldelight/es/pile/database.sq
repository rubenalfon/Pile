import es.pile.core.domain.models.DocumentDetail;
import es.pile.core.domain.models.DocumentStatus;
import es.pile.core.domain.models.ImageCropData;
import java.time.LocalDateTime;
import kotlin.Boolean;
import kotlin.String;
import kotlin.collections.List;


-- PileModel

CREATE TABLE IF NOT EXISTS PileModel(
    id                      TEXT                    PRIMARY KEY,
    name                    TEXT                    NOT NULL,
    iconId                  TEXT                    NOT NULL,
    colorNumber             INTEGER,
    modificationDateTime    TEXT AS LocalDateTime   NOT NULL
);

insertPileModel:
INSERT OR REPLACE INTO PileModel(id, name, iconId, colorNumber, modificationDateTime)
VALUES(?,?,?,?,?);

selectAllPileModels:
SELECT PileModel.*
FROM PileModel
ORDER BY PileModel.name ASC;

selectPileModelById:
SELECT PileModel.*
FROM PileModel
WHERE PileModel.id = ?;

selectPileModelsById:
SELECT PileModel.*
FROM PileModel
WHERE id IN ?
ORDER BY PileModel.name ASC;

updatePileModel:
UPDATE PileModel
SET name = ?,
    iconId = ?,
    colorNumber = ?,
    modificationDateTime = ?
WHERE id = ?;

updatePileModelName:
UPDATE PileModel
SET name = ?,
    modificationDateTime = ?
WHERE id = ?;

updatePileModelIcon:
UPDATE PileModel
SET iconId = ?,
    modificationDateTime = ?
WHERE id = ?;

updatePileModelColor:
UPDATE PileModel
SET colorNumber = ?,
    modificationDateTime = ?
WHERE id = ?;

removePileModel:
DELETE FROM PileModel
WHERE PileModel.id = ?;


-- DocumentOrganization

CREATE TABLE IF NOT EXISTS DocumentOrganization(
    id              TEXT        PRIMARY KEY,
    name            TEXT        NOT NULL
);

insertDocumentOrganization:
INSERT OR REPLACE INTO DocumentOrganization(id, name)
VALUES(?, ?);

selectAllDocumentOrganizations:
SELECT *
FROM DocumentOrganization;

selectDocumentOrganizationById:
SELECT *
FROM DocumentOrganization
WHERE id = ?;

removeDocumentOrganization:
DELETE FROM DocumentOrganization
WHERE id = ?;


-- DocumentModel

CREATE TABLE IF NOT EXISTS DocumentModel(
    id                          TEXT                            PRIMARY KEY,
    title                       TEXT                            NOT NULL,
    imageIds                    TEXT AS List<String>            NOT NULL,
    creationDateTime            TEXT AS LocalDateTime               NOT NULL,
    modificationDateTime        TEXT AS LocalDateTime               NOT NULL,
    documentStatus              INTEGER  AS DocumentStatus      NOT NULL,
    documentPileIds             TEXT AS List<String>            NOT NULL,
    documentDetails             TEXT AS List<DocumentDetail>    NOT NULL,
    documentNote                TEXT                            NOT NULL,
    documentOrganizationIds     TEXT AS List<String>            NOT NULL,
    isIncomingPdf               INTEGER AS Boolean              NOT NULL
);

insertDocumentModel:
INSERT OR REPLACE INTO DocumentModel(id, title, imageIds, creationDateTime, modificationDateTime, documentStatus, documentPileIds, documentDetails, documentNote, documentOrganizationIds, isIncomingPdf)
VALUES(?, ?, ?, ?,?, ?, ?, ?, ?, ?, ?);

selectAllDocumentModels:
SELECT *
FROM DocumentModel;

selectDocumentModelById:
SELECT *
FROM DocumentModel
WHERE id = ?;

selectDocumentModelsByPileId:
SELECT *
FROM DocumentModel
WHERE documentPileIds LIKE ('%"' || ? || '"%');

selectDocumentModelsByStatus:
SELECT *
FROM DocumentModel
WHERE documentStatus = ?;

removeDocumentModel:
DELETE FROM DocumentModel
WHERE id = ?;

updateFullDocumentModel:
UPDATE DocumentModel
SET title = ?,
    imageIds = ?,
    modificationDateTime = ?,
    documentStatus = ?,
    documentPileIds = ?,
    documentDetails = ?,
    documentNote = ?,
    documentOrganizationIds = ?,
    isIncomingPdf = ?
WHERE id = ?;

updateDocumentTitle:
UPDATE DocumentModel
SET title = ?
WHERE id = ?;

updateDocumentImageIds:
UPDATE DocumentModel
SET imageIds = ?
WHERE id = ?;

updateDocumentModificationDateTime:
UPDATE DocumentModel
SET modificationDateTime = ?
WHERE id = ?;

updateDocumentStatus:
UPDATE DocumentModel
SET documentStatus = ?
WHERE id = ?;

updateDocumentPileIds:
UPDATE DocumentModel
SET documentPileIds = ?
WHERE id = ?;

updateDocumentDetails:
UPDATE DocumentModel
SET documentDetails = ?
WHERE id = ?;

updateDocumentNote:
UPDATE DocumentModel
SET documentNote = ?
WHERE id = ?;

updateDocumentOrganizationIds:
UPDATE DocumentModel
SET documentOrganizationIds = ?
WHERE id = ?;

updateDocumentIsIncomingPdf:
UPDATE DocumentModel
SET isIncomingPdf = ?
WHERE id = ?;


-- DocumentImage

CREATE TABLE IF NOT EXISTS DocumentImage(
    id                      TEXT                    PRIMARY KEY,
    isDraft                 INTEGER AS Boolean      NOT NULL,
    crop                    TEXT AS ImageCropData,
    filter                  INTEGER                 NOT NULL,
    rotation                INTEGER                 NOT NULL,
    modificationDateTime    TEXT AS LocalDateTime   NOT NULL
);

insertDocumentImage:
INSERT OR REPLACE INTO DocumentImage(id, isDraft, crop, filter, rotation, modificationDateTime)
VALUES(?, ?, ?, ?, ?, ?);

selectAllDocumentImages:
SELECT *
FROM DocumentImage;

selectDocumentImageById:
SELECT *
FROM DocumentImage
WHERE id = ?;

removeDocumentImage:
DELETE FROM DocumentImage
WHERE id = ?;

updateFullDocumentImage:
UPDATE DocumentImage
SET isDraft = ?,
    crop = ?,
    filter = ?,
    rotation = ?,
    modificationDateTime = ?
WHERE id = ?;

updateDraft:
UPDATE DocumentImage
SET isDraft = ?,
    modificationDateTime = ?
WHERE id = ?;

updateCrop:
UPDATE DocumentImage
SET crop = ?,
    modificationDateTime = ?
WHERE id = ?;

updateFilter:
UPDATE DocumentImage
SET filter = ?,
    modificationDateTime = ?
WHERE id = ?;

updateRotation:
UPDATE DocumentImage
SET rotation = ?,
    modificationDateTime = ?
WHERE id = ?;


-- DeletedEntity

CREATE TABLE IF NOT EXISTS DeletedEntity(
    id                  TEXT                    PRIMARY KEY,
    type                TEXT                    NOT NULL,
    deletedDateTime    TEXT AS LocalDateTime   NOT NULL
);

insertDeletedEntity:
INSERT OR REPLACE INTO DeletedEntity(id, type, deletedDateTime)
VALUES(?, ?, ?);

selectAllDeletedEntities:
SELECT *
FROM DeletedEntity;

selectDeletedEntitiesByType:
SELECT *
FROM DeletedEntity
WHERE type = ?;

removeDeletedEntity:
DELETE FROM DeletedEntity
WHERE id = ?;

